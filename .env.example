# Google Apps Script API URLs
# Replace with your deployed GAS Web App URLs

# Homepage Content API
VITE_GAS_HOMEPAGE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Login/Authentication API (also used for Directory search - same GAS project)
VITE_GAS_LOGIN_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Meet API (optional dedicated Meet deployment; if unset, frontend falls back to Login API URL)
VITE_GAS_MEET_API_URL=https://script.google.com/macros/s/YOUR_MEET_DEPLOYMENT_ID/exec
# System Tools API - Connects to SystemTools_Main.gs
VITE_GAS_SYSTEM_TOOLS_API_URL=https://script.google.com/macros/s/YOUR_SYSTEM_TOOLS_DEPLOYMENT_ID/exec

# Events Management API (separate GAS project for Attendance_Events.gs)
VITE_GAS_EVENTS_API_URL=https://script.google.com/macros/s/YOUR_EVENTS_DEPLOYMENT_ID/exec

# Notifications API (separate GAS project for Notifications_Main.gs)
VITE_GAS_NOTIFICATIONS_API_URL=https://script.google.com/macros/s/YOUR_NOTIFICATIONS_DEPLOYMENT_ID/exec

# Shared Drive API (optional)
VITE_GAS_DRIVE_API_URL=

# Organizational Task API (optional)
VITE_GAS_TASK_API_URL=

# Shared GAS API Key (required by protected endpoints)
VITE_GAS_API_KEY=YOUR_GAS_API_KEY

# Firebase Web Push (FCM)
VITE_FIREBASE_SDK_VERSION=10.13.2
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_VAPID_KEY=YOUR_PUBLIC_VAPID_KEY

# Add more GAS API URLs here as needed
# Issuance Center API
VITE_GAS_ISSUANCE_API_URL=https://script.google.com/macros/s/YOUR_ISSUANCE_DEPLOYMENT_ID/exec

# Feedback API
VITE_GAS_FEEDBACK_API_URL=https://script.google.com/macros/s/YOUR_FEEDBACK_DEPLOYMENT_ID/exec

# Announcements API (dedicated GAS deployment)
VITE_GAS_ANNOUNCEMENTS_API_URL=https://script.google.com/macros/s/YOUR_ANNOUNCEMENTS_DEPLOYMENT_ID/exec

# ChatBot API
VITE_GAS_CHATBOT_API_URL=https://script.google.com/macros/s/YOUR_CHATBOT_DEPLOYMENT_ID/exec

# Email System API - Connects to EmailSystem_Main.gs
VITE_GAS_EMAIL_SYSTEM_API_URL=https://script.google.com/macros/s/YOUR_EMAIL_SYSTEM_DEPLOYMENT_ID/exec

# App metadata
VITE_APP_VERSION=1.0.0

# Debug toggles (development only)
VITE_DEBUG_EVENTS=false
VITE_DEBUG_APPLICANTS=false
VITE_DEBUG_MYQR=false

# Chapter and Organization Customization
VITE_ORG_NAME=Youth Service Philippines
VITE_CHAPTER_NAME=Tagum Chapter
VITE_CHAPTER_LOCATION=Tagum
VITE_SHORT_NAME=YSP Tagum
VITE_ORG_MOTTO=Shaping the Future to a Greater Society
VITE_CHAPTER_CODE=TC
VITE_ORG_LOCATION=Tagum City, Davao del Norte, Philippines
VITE_ORG_EMAIL=ysptagumchapter@gmail.com
VITE_ORG_LOGO_URL=https://i.imgur.com/J4wddTW.png
VITE_THEME_COLOR="#f6421f"

